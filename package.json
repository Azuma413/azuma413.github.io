{
  "name": "modern-personal-homepage",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"require('fs').copyFileSync('dist/index.html', 'dist/404.html')\"",
    "prebuild": "node scripts/fetch-url-metadata.js && node scripts/fetch-notion-posts.js",
    "preview": "vite preview",
    "fetch-metadata": "node scripts/fetch-url-metadata.js",
    "fetch-notion": "node scripts/fetch-notion-posts.js"
  },
  "dependencies": {
    "@notionhq/client": "^2.2.15",
    "notion-to-md": "^3.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "9.0.1",
    "react-router-dom": "^6.30.3",
    "rehype-raw": "^7.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "baseline-browser-mapping": "^2.10.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
